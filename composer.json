{
    "name": "hampel/sparkpost-laravel",
    "description": "Laravel mail driver for SparkPost, built on hampel/sparkpost-transport",
    "authors": [
        {
            "name": "Simon Hampel",
            "email": "simon@hampelgroup.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/hampel/sparkpost-laravel/issues",
        "source": "https://github.com/hampel/sparkpost-laravel"
    },
    "keywords": [
        "sparkpost",
        "email",
        "laravel",
        "mail",
        "driver"
    ],
    "homepage": "https://github.com/hampel/sparkpost-laravel",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "guzzlehttp/psr7": "^2.0|^3.0",
        "hampel/sparkpost": "^0.3.0",
        "hampel/sparkpost-transport": "^0.4.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.1.22",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Hampel\\SparkPost\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hampel\\SparkPost\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hampel\\SparkPost\\Laravel\\SparkPostServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "lint": "pint --test",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
